# ============================================================
# PromiseOS Backend Configuration
# ============================================================

# APP
APP_ENV=development
DEBUG=true
MOCK_LLM=true
ML_COMMITMENT_ENABLED=true
ML_MODEL_PATH=ml/models/commitment_classifier_v2_calibrated.joblib

# DATABASE
# For local dev without Postgres/Supabase, defaults to sqlite+aiosqlite:///./promiseos.db
DATABASE_URL=sqlite+aiosqlite:///./promiseos.db
SUPABASE_URL=
SUPABASE_KEY=

# AI PROVIDERS (Empty for local testing with MOCK_LLM=true)
# When keys are configured, LLMRouter uses priority: Groq -> NVIDIA -> SambaNova -> Gemini -> OpenRouter
GROQ_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# OPTIONAL EXTERNAL EVIDENCE SERVICES
COHERE_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# FILE STORAGE
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=./data/uploads

# CORS
# Comma-separated allowed origins for frontend integration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
